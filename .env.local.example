# Local Development Environment Configuration
# This file is for local development only and should not be committed to version control

# Environment Configuration
VITE_ENVIRONMENT=development

# Azure Application Insights Configuration
# Get your connection string from Azure Portal > Application Insights > Overview > Connection String
VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-dev-instrumentation-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/;LiveEndpoint=https://your-region.livediagnostics.monitor.azure.com/;ApplicationId=your-dev-application-id

# Application Version
VITE_APP_VERSION=1.0.0-dev

# Optional: Override default settings for development
# VITE_DEBUG_MODE=true