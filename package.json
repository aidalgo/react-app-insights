{
  "name": "react-app-insights-sample",
  "description": "A sample React application demonstrating Azure Application Insights integration with custom telemetry tracking and Azure Workbook dashboard",
  "version": "1.0.0",
  "type": "module",
  "keywords": [
    "react",
    "azure",
    "application-insights",
    "telemetry",
    "monitoring",
    "workbook",
    "sample",
    "demo"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/react-app-insights-sample.git"
  },
  "homepage": "https://github.com/yourusername/react-app-insights-sample#readme",
  "bugs": {
    "url": "https://github.com/yourusername/react-app-insights-sample/issues"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:staging": "vite --mode staging",
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "build:development": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "setup": "./setup-azure.sh --interactive",
    "setup:env": "cp .env.example .env.local && echo 'Please update .env.local with your Application Insights connection string'",
    "deploy:workbook": "./azure/deploy-workbook.sh"
  },
  "dependencies": {
    "@microsoft/applicationinsights-react-js": "^19.3.7",
    "@microsoft/applicationinsights-web": "^3.3.9",
    "history": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
