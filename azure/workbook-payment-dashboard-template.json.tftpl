      "name": "query - 11"
    },
    {
      "type": 1,
      "content": {
        "json": "## Beneficiaries Saved Per Day\nDaily count of beneficiaries added or updated through payment submissions."
      },
      "name": "text - 12"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "f6a7b8c9-0d1e-2f3a-4b5c-6d7e8f9a0b1c",
            "version": "KqlParameterItem/1.0",
            "name": "BeneficiarySplitBy",
            "type": 2,
            "isRequired": true,
            "query": "datatable(value:string, text:string)[\n'tostring(customDimensions.sunId)', '🏢 SUNID',\n'tostring(customDimensions.companyName)', '🏢 Company Name',\n'tostring(customDimensions.userId)', '👤 User ID',\n'tostring(customDimensions.branchId)', '🏪 Branch ID'\n]",
            "value": "tostring(customDimensions.sunId)",
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "queryType": 0,
            "resourceType": "microsoft.insights/components"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.insights/components"
      },
      "name": "parameters - 13"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend BeneficiariesAdded = toint(customDimensions.beneficiariesAdded)\n| extend BeneficiariesUpdated = toint(customDimensions.beneficiariesUpdated)\n| summarize ['Beneficiaries Added'] = sum(BeneficiariesAdded),\n            ['Beneficiaries Updated'] = sum(BeneficiariesUpdated),\n            ['Total Saved'] = sum(BeneficiariesAdded) + sum(BeneficiariesUpdated)\n            by Day = bin(timestamp, 1d)\n| order by Day asc",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "Beneficiaries Saved Over Time",
        "color": "orange",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "areachart",
        "chartSettings": {
          "seriesLabelSettings": [
            {
              "seriesName": "Beneficiaries Added",
              "color": "greenDark"
            },
            {
              "seriesName": "Beneficiaries Updated",
              "color": "yellow"
            },
            {
              "seriesName": "Total Saved",
              "color": "orange"
            }
          ],
          "ySettings": {
            "numberFormatSettings": {
              "unit": 0,
              "options": {
                "style": "decimal",
                "useGrouping": true
              }
            }
          }
        }
      },
      "name": "query - 14"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend SplitBy = {BeneficiarySplitBy}\n| extend BeneficiariesAdded = toint(customDimensions.beneficiariesAdded)\n| extend BeneficiariesUpdated = toint(customDimensions.beneficiariesUpdated)\n| extend BeneficiariesCount = toint(customDimensions.beneficiariesCount)\n| summarize ['Beneficiaries Added'] = sum(BeneficiariesAdded),\n            ['Beneficiaries Updated'] = sum(BeneficiariesUpdated),\n            ['Total Saved'] = sum(BeneficiariesAdded) + sum(BeneficiariesUpdated),\n            ['Payment Count'] = count(),\n            ['Avg Beneficiary Count'] = avg(BeneficiariesCount),\n            ['Unique Beneficiaries'] = dcount(tostring(customDimensions.beneficiaryId))\n            by SplitBy\n| order by ['Total Saved'] desc\n| project ['Group'] = strcat('🔹 ', SplitBy), ['Beneficiaries Added'], ['Beneficiaries Updated'], ['Total Saved'], ['Payment Count'], ['Avg Beneficiary Count'], ['Unique Beneficiaries']",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "Beneficiary Management Details",
        "exportFieldName": "Group",
        "exportParameterName": "BeneficiaryFilter",
        "exportDefaultValue": "All",
        "queryType": 0,
