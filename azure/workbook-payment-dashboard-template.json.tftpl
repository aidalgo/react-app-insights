{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## Payment Dashboard\n\nThis dashboard tracks payment activities including wire payments and beneficiary management. Use the filters below to customize the time range and view specific metrics.\n"
      },
      "name": "text - 0"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 2592000000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 5184000000
                },
                {
                  "durationMs": 7776000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "b2c3d4e5-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
            "version": "KqlParameterItem/1.0",
            "name": "PaymentType",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "customEvents\n| where timestamp >= ago(7d)\n| where name == 'Payments_InitiationReview_Click_Submit'\n| summarize count() by PaymentType = tostring(customDimensions.paymentType)\n| order by count_ desc\n| project Id=PaymentType, Title=PaymentType, Selected=case(PaymentType == 'WIRE', true, false)\n| union (\ndatatable(Id:string, Title:string, Selected:boolean)[\n'*', 'All Payment Types', false\n]\n)",
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "queryType": 0,
            "resourceType": "microsoft.insights/components"
          },
          {
            "id": "c3d4e5f6-7a8b-9c0d-1e2f-3a4b5c6d7e8f",
            "version": "KqlParameterItem/1.0",
            "name": "OtherFilters",
            "type": 1,
            "description": "A KQL snippet that further filters the data. Example: | where customDimensions.sunId == '100001'"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.insights/components"
      },
      "name": "parameters - 1"
    },
    {
      "type": 1,
      "content": {
        "json": "### Key Metrics Summary\nOverview of payment activities for the selected time period."
      },
      "name": "text - 2"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "// Duration from workbook TimeRange parameter\nlet duration = {TimeRange:end} - {TimeRange:start};\nlet startTime = ago(duration);\n\n// Base successful submissions for selected (or all) payment types\nlet base =\n    customEvents\n    | where timestamp between (startTime .. now())\n    | where name == 'Payments_InitiationReview_Click_Submit'\n    | where tostring(customDimensions.transactionStatus) == 'Submitted'\n    {OtherFilters}\n    | where ('*' in ({PaymentType}) or tostring(customDimensions.paymentType) in ({PaymentType}));\n\n// Typed fields\nlet enriched =\n    base\n    | extend Amount               = coalesce(todouble(customDimensions.amount), 0.0),\n             BeneficiariesAdded   = coalesce(toint(customDimensions.beneficiariesAdded), 0),\n             BeneficiariesUpdated = coalesce(toint(customDimensions.beneficiariesUpdated), 0);\n\n// Single aggregate (may yield 0 rows if no events)\nlet agg =\n    enriched\n    | summarize WirePayments = count(),\n                TotalNotional = sum(Amount),\n                BeneficiariesSaved = sum(BeneficiariesAdded) + sum(BeneficiariesUpdated);\n\n// Turn aggregate into metric rows\nlet metrics = union\n    (agg | project Title='Wire Payments',       SubTitle='Total submissions',       Metric=toreal(WirePayments)),\n    (agg | project Title='Total Notional',      SubTitle='Sum of payment amounts',  Metric=coalesce(TotalNotional, 0.0)),\n    (agg | project Title='Beneficiaries Saved', SubTitle='Added + Updated',         Metric=toreal(BeneficiariesSaved));\n\n// Fallback rows (ensures 3 rows even if agg empty)\nlet fallback = datatable(Title:string, SubTitle:string, Metric:real) [\n    'Wire Payments','Total submissions',0,\n    'Total Notional','Sum of payment amounts',0,\n    'Beneficiaries Saved','Added + Updated',0\n];\n\n// Merge and keep the non-zero (or actual) values\nunion metrics, fallback\n| summarize Metric = max(Metric) by Title, SubTitle\n| order by Title asc",
        "size": 3,
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Title",
            "formatter": 1,
            "formatOptions": {
              "showIcon": true
            }
          },
          "subtitleContent": {
            "columnMatch": "SubTitle",
            "formatOptions": {
              "showIcon": true
            }
          },
          "leftContent": {
            "columnMatch": "Metric",
            "formatter": 12,
            "formatOptions": {
              "min": 0,
              "showIcon": true
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "style": "decimal",
                "maximumFractionDigits": 2,
                "maximumSignificantDigits": 3
              }
            }
          },
          "showBorder": false
        }
      },
      "name": "query - 3"
    },
    {
      "type": 1,
      "content": {
        "json": "## Wire Payments Per Day\nDaily count of wire payments submitted through the portal."
      },
      "name": "text - 4"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "d4e5f6a7-8b9c-0d1e-2f3a-4b5c6d7e8f9a",
            "version": "KqlParameterItem/1.0",
            "name": "WirePaymentSplitBy",
            "type": 2,
            "isRequired": true,
            "query": "datatable(value:string, text:string)[\n'tostring(customDimensions.currency)', '💰 Currency',\n'tostring(customDimensions.sunId)', '🏢 SUNID',\n'tostring(customDimensions.companyName)', '🏢 Company Name',\n'tostring(customDimensions.branchId)', '🏪 Branch ID',\n'tostring(customDimensions.userId)', '👤 User ID',\n'tostring(customDimensions.transactionStatus)', '📊 Transaction Status'\n]",
            "value": "tostring(customDimensions.currency)",
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "queryType": 0,
            "resourceType": "microsoft.insights/components"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.insights/components"
      },
      "name": "parameters - 5"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| summarize ['Wire Payments'] = count() by Day = bin(timestamp, 1d)\n| order by Day asc",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "Wire Payments Over Time",
        "color": "blue",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "barchart",
        "chartSettings": {
          "seriesLabelSettings": [
            {
              "seriesName": "Wire Payments",
              "color": "blue"
            }
          ],
          "ySettings": {
            "numberFormatSettings": {
              "unit": 0,
              "options": {
                "style": "decimal",
                "useGrouping": true
              }
            }
          }
        }
      },
      "name": "query - 6"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend SplitBy = {WirePaymentSplitBy}\n| extend Amount = todouble(customDimensions.amount)\n| summarize ['Payment Count'] = count(),\n            ['Total Amount'] = sum(Amount),\n            ['Average Amount'] = avg(Amount),\n            ['Min Amount'] = min(Amount),\n            ['Max Amount'] = max(Amount),\n            ['Unique Users'] = dcount(tostring(customDimensions.userId)),\n            ['Unique Companies'] = dcount(tostring(customDimensions.sunId))\n            by SplitBy\n| order by ['Payment Count'] desc\n| project ['Group'] = strcat('🔹 ', SplitBy), ['Payment Count'], ['Total Amount'], ['Average Amount'], ['Min Amount'], ['Max Amount'], ['Unique Users'], ['Unique Companies']",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "Wire Payment Details",
        "exportFieldName": "Group",
        "exportParameterName": "WirePaymentFilter",
        "exportDefaultValue": "All",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Payment Count",
              "formatter": 3,
              "formatOptions": {
                "min": 0,
                "palette": "blue",
                "showIcon": true
