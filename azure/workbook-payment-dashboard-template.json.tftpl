                  "maximumFractionDigits": 2
                }
              }
            },
            {
              "columnMatch": "Unique Users",
              "formatter": 3,
              "formatOptions": {
                "min": 0,
                "palette": "purple",
                "showIcon": true
              }
            },
            {
              "columnMatch": "Unique Companies",
              "formatter": 3,
              "formatOptions": {
                "min": 0,
                "palette": "orange",
                "showIcon": true
              }
            }
          ],
          "filter": true
        }
      },
      "name": "query - 7"
    },
    {
      "type": 1,
      "content": {
        "json": "## Total Notional (Payment Amounts) Per Day\nSum of payment amounts submitted each day."
      },
      "name": "text - 8"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "e5f6a7b8-9c0d-1e2f-3a4b-5c6d7e8f9a0b",
            "version": "KqlParameterItem/1.0",
            "name": "NotionalSplitBy",
            "type": 2,
            "isRequired": true,
            "query": "datatable(value:string, text:string)[\n'tostring(customDimensions.currency)', '💰 Currency',\n'tostring(customDimensions.sunId)', '🏢 SUNID',\n'tostring(customDimensions.companyName)', '🏢 Company Name',\n'tostring(customDimensions.paymentType)', '💳 Payment Type'\n]",
            "value": "tostring(customDimensions.currency)",
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "queryType": 0,
            "resourceType": "microsoft.insights/components"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.insights/components"
      },
      "name": "parameters - 9"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend SplitBy = {NotionalSplitBy}\n| extend Amount = todouble(customDimensions.amount)\n| summarize ['Total Notional'] = sum(Amount) by Day = bin(timestamp, 1d), SplitBy\n| order by Day asc",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "Total Notional Over Time",
        "color": "green",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "linechart",
        "chartSettings": {
          "seriesLabelSettings": [
            {
              "seriesName": "Total Notional",
              "color": "green"
            },
            {
              "seriesName": "Payment Count",
              "color": "blueDark"
            }
          ],
          "ySettings": {
            "numberFormatSettings": {
              "unit": 0,
              "options": {
                "style": "decimal",
                "useGrouping": true,
                "minimumFractionDigits": 2,
                "maximumFractionDigits": 2
              }
            }
          }
        }
      },
      "name": "query - 10"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend SplitBy = {NotionalSplitBy}\n| extend Amount = todouble(customDimensions.amount)\n| summarize ['Payment Count'] = count(),\n            ['Total Notional'] = sum(Amount),\n            ['Average Amount'] = avg(Amount),\n            ['Median Amount'] = percentile(Amount, 50),\n            ['95th Percentile'] = percentile(Amount, 95)\n            by SplitBy\n| order by ['Total Notional'] desc\n| project ['Group'] = strcat('🔹 ', SplitBy), ['Payment Count'], ['Total Notional'], ['Average Amount'], ['Median Amount'], ['95th Percentile']",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "Notional Amount Details",
        "exportFieldName": "Group",
        "exportParameterName": "NotionalFilter",
        "exportDefaultValue": "All",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "table",
