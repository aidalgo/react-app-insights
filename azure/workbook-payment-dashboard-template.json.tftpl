      "name": "query - 15"
    },
    {
      "type": 1,
      "content": {
        "json": "## Payment Activity by Currency\nBreakdown of payment activity across different currencies."
      },
      "name": "text - 16"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend Currency = tostring(customDimensions.currency)\n| extend Amount = todouble(customDimensions.amount)\n| summarize ['Payment Count'] = count(),\n            ['Total Amount'] = sum(Amount)\n            by Currency\n| order by ['Payment Count'] desc",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "Payment Distribution by Currency",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "piechart"
      },
      "name": "query - 17"
    },
    {
      "type": 1,
      "content": {
        "json": "## All Payment Metrics Combined\nCombined timeline view of all tracked payment metrics."
      },
      "name": "text - 18"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let start = startofday(ago({TimeRange:end} - {TimeRange:start}));\nlet wirePayments = customEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| summarize Value = count() by Day = bin(timestamp, 1d)\n| extend Metric = '💳 Wire Payments';\nlet notional = customEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend Amount = todouble(customDimensions.amount)\n| summarize Value = sum(Amount) / 1000000 by Day = bin(timestamp, 1d)\n| extend Metric = '💰 Total Notional (M)';\nlet beneficiaries = customEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where customDimensions.transactionStatus == 'Submitted'\n{OtherFilters}\n| extend BeneficiariesAdded = toint(customDimensions.beneficiariesAdded)\n| extend BeneficiariesUpdated = toint(customDimensions.beneficiariesUpdated)\n| summarize Value = todouble(sum(BeneficiariesAdded) + sum(BeneficiariesUpdated)) by Day = bin(timestamp, 1d)\n| extend Metric = '👥 Beneficiaries Saved';\nunion wirePayments, notional, beneficiaries\n| order by Day asc",
        "size": 0,
        "aggregation": 5,
        "showAnalytics": true,
        "title": "All Payment Metrics Timeline",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "linechart"
      },
      "name": "query - 19"
    }
  ],
  "fallbackResourceIds": [
    "${subscription_id}/resourceGroups/${resource_group_name}/providers/microsoft.insights/components/${application_insights_name}"
  ],
  "fromTemplateId": "custom-PaymentDashboard",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
