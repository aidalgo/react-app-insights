{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# 📊 React App Insights - Combined Dashboard\n\nComprehensive monitoring dashboard combining all key metrics: User Activity, Payments, Admin Operations, and Observability.\n\n---"
      },
      "name": "main-header"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
        "style": "tabs",
        "links": [
          {
            "id": "tab-user-activity",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "👥 User Activity",
            "subTarget": "UserActivity",
            "style": "link"
          },
          {
            "id": "tab-payment",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "💳 Payment Dashboard",
            "subTarget": "Payment",
            "style": "link"
          },
          {
            "id": "tab-admin",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "⚙️ Admin Dashboard",
            "subTarget": "Admin",
            "style": "link"
          },
          {
            "id": "tab-observability",
            "cellValue": "selectedTab",
            "linkTarget": "parameter",
            "linkLabel": "🔍 Observability",
            "subTarget": "Observability",
            "style": "link"
          }
        ]
      },
      "name": "navigation-tabs"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "👥 User Activity Dashboard",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Active Users\n\nActive users counts how many users have used your app at least once in a previous time period. It is typically used to answer -- *How many users does your app or feature have?*. Edit the `Activities` parameter below to customize what custom events and page views qualify as active usage."
            },
            "name": "ua-text-0"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "ua-metric-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "UAMetric",
                  "type": 2,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "jsonData": "[\n    { \"value\":\"1d\", \"label\":\"Daily Active Users\", \"selected\":false },\n    { \"value\":\"7d\", \"label\":\"Weekly Active Users\", \"selected\":false },\n    { \"value\":\"28d\", \"label\":\"Monthly Active Users (28d)\", \"selected\":true },\n    { \"value\":\"30d\", \"label\":\"Monthly Active Users (30d)\", \"selected\":false }\n]"
                },
                {
                  "id": "ua-activities-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "UAActivities",
                  "type": 2,
                  "description": "A comma separated set of Page views or Events that are to be counted as activities. Or use '*' to include all events.",
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "union customEvents, pageViews\n| where timestamp >= ago(7d)\n| summarize count() by name\n| order by count_ desc\n| project Id=name, Title=name, Selected=false\n| union (\ndatatable(Id:string, Title:string, Selected:boolean)[\n'*', 'All Events and Page Views', true,\n'%', 'All Page Views', false,\n'#', 'All Custom Events', false\n]\n)",
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.insights/components"
                },
                {
                  "id": "ua-filters-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "UAFilters",
                  "type": 1,
                  "description": "A KQL snippet that further filters the activities. Example: | where application_Version == '1.0'"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.insights/components"
            },
            "name": "ua-parameters-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let start = startofday(ago({UAMetric}));\nunion customEvents, pageViews\n| where timestamp >= start\n| where name in ({UAActivities}) or '*' in ({UAActivities}) or ('%' in ({UAActivities}) and itemType == 'pageView') or ('#' in ({UAActivities}) and itemType == 'customEvent')\n{UAFilters}\n| summarize Users = dcount(user_Id), Sessions = dcount(session_Id), Views = count()\n| evaluate narrow()\n| project Title = case(Column == 'Users', 'Active Users', Column == 'Sessions', 'Unique Sessions', 'Views'), Metric = Value, SubTitle = '━━'",
              "size": 3,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Title",
                  "formatter": 1
                },
                "subtitleContent": {
                  "columnMatch": "SubTitle"
                },
                "leftContent": {
                  "columnMatch": "Metric",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "showBorder": false
              }
            },
            "name": "ua-query-summary"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "ua-timerange-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "UATimeRange",
                  "type": 4,
                  "isRequired": true,
                  "value": {
                    "durationMs": 2592000000
                  },
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 1209600000
                      },
                      {
                        "durationMs": 2592000000
                      },
                      {
                        "durationMs": 5184000000
                      },
                      {
                        "durationMs": 7776000000
                      }
                    ]
                  }
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.insights/components"
            },
            "name": "ua-parameters-timerange"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let ts = {UATimeRange:end} - {UATimeRange:start};\nlet start = startofday(ago(ts + {UAMetric}));\nunion customEvents, pageViews\n| where timestamp >= start\n| where name in ({UAActivities}) or '*' in ({UAActivities}) or ('%' in ({UAActivities}) and itemType == 'pageView') or ('#' in ({UAActivities}) and itemType == 'customEvent')\n{UAFilters}\n| evaluate activity_engagement(user_Id, timestamp, start, now(), 1d, {UAMetric})\n| where timestamp >= startofday(ago(ts))\n| project timestamp, ['Active Users'] = dcount_activities_outer\n| render timechart",
              "size": 0,
              "aggregation": 5,
              "title": "Active Users Trend",
              "color": "blue",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "areachart"
            },
            "name": "ua-query-trend"
          },
          {
            "type": 1,
            "content": {
              "json": "## Daily Authenticated Users\nThis chart shows the number of unique authenticated users active each day."
            },
            "name": "ua-text-auth"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let ts = {UATimeRange:end} - {UATimeRange:start};\nlet start = startofday(ago(ts));\nunion pageViews, customEvents\n| where timestamp >= start\n| where isnotempty(user_AuthenticatedId)\n| summarize DAU = dcount(user_AuthenticatedId) by Day = bin(timestamp, 1d)\n| order by Day asc\n| project Day, ['Daily Authenticated Users'] = DAU",
              "size": 0,
              "aggregation": 5,
              "title": "Authenticated Users Per Day",
              "color": "green",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "barchart",
              "chartSettings": {
                "seriesLabelSettings": [
                  {
                    "seriesName": "Daily Authenticated Users",
                    "color": "green"
                  }
                ]
              }
            },
            "name": "ua-query-authenticated"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "UserActivity"
      },
      "name": "group-user-activity"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "💳 Payment Dashboard",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Payment Dashboard\n\nThis dashboard tracks payment activities including wire payments and beneficiary management."
            },
            "name": "payment-text-0"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "payment-timerange-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "PaymentTimeRange",
                  "type": 4,
                  "isRequired": true,
                  "value": {
                    "durationMs": 2592000000
                  },
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 86400000
                      },
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 2592000000
                      },
                      {
                        "durationMs": 5184000000
                      }
                    ],
                    "allowCustom": true
                  }
                },
                {
                  "id": "payment-type-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "PaymentType",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "customEvents\n| where timestamp >= ago(7d)\n| where name == 'Payments_InitiationReview_Click_Submit'\n| summarize count() by PaymentType = tostring(customDimensions.paymentType)\n| order by count_ desc\n| project Id=PaymentType, Title=PaymentType, Selected=case(PaymentType == 'WIRE', true, false)\n| union (\ndatatable(Id:string, Title:string, Selected:boolean)[\n'*', 'All Payment Types', false\n]\n)",
                  "typeSettings": {
                    "additionalResourceOptions": []
                  },
                  "queryType": 0,
                  "resourceType": "microsoft.insights/components"
                },
                {
                  "id": "payment-filters-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "PaymentFilters",
                  "type": 1,
                  "description": "A KQL snippet that further filters the data. Example: | where customDimensions.sunId == '100001'"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.insights/components"
            },
            "name": "payment-parameters-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let duration = {PaymentTimeRange:end} - {PaymentTimeRange:start};\nlet startTime = ago(duration);\nlet base = customEvents\n| where timestamp between (startTime .. now())\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.transactionStatus) == 'Submitted'\n{PaymentFilters}\n| where ('*' in ({PaymentType}) or tostring(customDimensions.paymentType) in ({PaymentType}));\nlet enriched = base\n| extend Amount = coalesce(todouble(customDimensions.amount), 0.0),\n         BeneficiariesAdded = coalesce(toint(customDimensions.beneficiariesAdded), 0),\n         BeneficiariesUpdated = coalesce(toint(customDimensions.beneficiariesUpdated), 0);\nlet agg = enriched\n| summarize WirePayments = count(),\n            TotalNotional = sum(Amount),\n            BeneficiariesSaved = sum(BeneficiariesAdded) + sum(BeneficiariesUpdated);\nlet metrics = union\n    (agg | project Title='Wire Payments', SubTitle='Total submissions', Metric=toreal(WirePayments)),\n    (agg | project Title='Total Notional', SubTitle='Sum of payment amounts', Metric=coalesce(TotalNotional, 0.0)),\n    (agg | project Title='Beneficiaries Saved', SubTitle='Added + Updated', Metric=toreal(BeneficiariesSaved));\nlet fallback = datatable(Title:string, SubTitle:string, Metric:real) [\n    'Wire Payments','Total submissions',0,\n    'Total Notional','Sum of payment amounts',0,\n    'Beneficiaries Saved','Added + Updated',0\n];\nunion metrics, fallback\n| summarize Metric = max(Metric) by Title, SubTitle\n| order by Title asc",
              "size": 3,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Title",
                  "formatter": 1
                },
                "subtitleContent": {
                  "columnMatch": "SubTitle"
                },
                "leftContent": {
                  "columnMatch": "Metric",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "showBorder": false
              }
            },
            "name": "payment-query-summary"
          },
          {
            "type": 1,
            "content": {
              "json": "## Wire Payments Over Time\nDaily count of wire payments submitted through the portal."
            },
            "name": "payment-text-chart"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let start = startofday(ago({PaymentTimeRange:end} - {PaymentTimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{PaymentFilters}\n| summarize ['Wire Payments'] = count() by Day = bin(timestamp, 1d)\n| order by Day asc",
              "size": 0,
              "aggregation": 5,
              "title": "Wire Payments Per Day",
              "color": "blue",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "barchart",
              "chartSettings": {
                "ySettings": {
                  "numberFormatSettings": {
                    "unit": 0,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true
                    }
                  }
                }
              }
            },
            "name": "payment-query-chart"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let start = startofday(ago({PaymentTimeRange:end} - {PaymentTimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Payments_InitiationReview_Click_Submit'\n| where tostring(customDimensions.paymentType) in ({PaymentType}) or '*' in ({PaymentType})\n| where customDimensions.transactionStatus == 'Submitted'\n{PaymentFilters}\n| extend Currency = tostring(customDimensions.currency)\n| extend Amount = todouble(customDimensions.amount)\n| summarize ['Payment Count'] = count(),\n            ['Total Amount'] = sum(Amount)\n            by Currency\n| order by ['Payment Count'] desc",
              "size": 0,
              "title": "Payment Activity by Currency",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Total Amount",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "filter": true
              }
            },
            "name": "payment-query-currency"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "Payment"
      },
      "name": "group-payment"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "⚙️ Admin Dashboard",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Admin Dashboard\n\nThis dashboard tracks key administrative activities including user creation, company onboarding, and authentication metrics."
            },
            "name": "admin-text-0"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "admin-timerange-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "AdminTimeRange",
                  "type": 4,
                  "isRequired": true,
                  "value": {
                    "durationMs": 2592000000
                  },
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 2592000000
                      },
                      {
                        "durationMs": 5184000000
                      },
                      {
                        "durationMs": 7776000000
                      }
                    ],
                    "allowCustom": true
                  }
                },
                {
                  "id": "admin-filters-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "AdminFilters",
                  "type": 1,
                  "description": "A KQL snippet that further filters the data. Example: | where customDimensions.sunId == '100001'"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.insights/components"
            },
            "name": "admin-parameters-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let start = startofday(ago({AdminTimeRange:end} - {AdminTimeRange:start}));\nlet usersCreated = customEvents\n| where timestamp >= start\n| where name == 'Admin_Approve_New_User_Click_Success'\n| where customDimensions.result == 'Success'\n{AdminFilters}\n| summarize Value = count();\nlet sunidsOnboarded = customEvents\n| where timestamp >= start\n| where name == 'InternalAdmin_CompanyOnboarding_Click_OnboardCompany'\n{AdminFilters}\n| summarize Value = dcount(tostring(customDimensions.submittedSunId));\nlet uniqueLogins = customEvents\n| where timestamp >= start\n| where name == 'Auth_Login_Success'\n{AdminFilters}\n| summarize Value = dcount(tostring(customDimensions.sunId));\nunion\n  (usersCreated | extend Title = 'Users Created', SubTitle = 'Total approved users'),\n  (sunidsOnboarded | extend Title = 'SUNIDs Onboarded', SubTitle = 'Unique companies'),\n  (uniqueLogins | extend Title = 'Unique Logins', SubTitle = 'Distinct SUNIDs')\n| project Title, SubTitle, Metric = Value",
              "size": 3,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Title",
                  "formatter": 1
                },
                "subtitleContent": {
                  "columnMatch": "SubTitle"
                },
                "leftContent": {
                  "columnMatch": "Metric",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal"
                    }
                  }
                },
                "showBorder": false
              }
            },
            "name": "admin-query-summary"
          },
          {
            "type": 1,
            "content": {
              "json": "## Users Created Over Time\nDaily count of users created through the admin portal."
            },
            "name": "admin-text-users"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let start = startofday(ago({AdminTimeRange:end} - {AdminTimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'Admin_Approve_New_User_Click_Success'\n| where customDimensions.result == 'Success'\n{AdminFilters}\n| summarize ['Users Created'] = count() by Day = bin(timestamp, 1d)\n| order by Day asc",
              "size": 0,
              "aggregation": 5,
              "title": "Users Created Per Day",
              "color": "blue",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "barchart",
              "chartSettings": {
                "seriesLabelSettings": [
                  {
                    "seriesName": "Users Created",
                    "color": "blue"
                  }
                ]
              }
            },
            "name": "admin-query-users"
          },
          {
            "type": 1,
            "content": {
              "json": "## SUNIDs Onboarded Over Time\nDaily count of distinct SUNIDs (companies) onboarded."
            },
            "name": "admin-text-sunids"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let start = startofday(ago({AdminTimeRange:end} - {AdminTimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name == 'InternalAdmin_CompanyOnboarding_Click_OnboardCompany'\n{AdminFilters}\n| summarize ['SUNIDs Onboarded'] = dcount(tostring(customDimensions.submittedSunId)) by Day = bin(timestamp, 1d)\n| order by Day asc",
              "size": 0,
              "aggregation": 5,
              "title": "SUNIDs Onboarded Per Day",
              "color": "green",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "barchart",
              "chartSettings": {
                "seriesLabelSettings": [
                  {
                    "seriesName": "SUNIDs Onboarded",
                    "color": "green"
                  }
                ]
              }
            },
            "name": "admin-query-sunids"
          },
          {
            "type": 1,
            "content": {
              "json": "## All Admin Activities Combined\nCombined view of all tracked admin activities."
            },
            "name": "admin-text-combined"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let start = startofday(ago({AdminTimeRange:end} - {AdminTimeRange:start}));\ncustomEvents\n| where timestamp >= start\n| where name in ('Admin_Approve_New_User_Click_Success', 'InternalAdmin_CompanyOnboarding_Click_OnboardCompany', 'Auth_Login_Success')\n{AdminFilters}\n| extend Activity = case(\n    name == 'Admin_Approve_New_User_Click_Success', '👤 User Created',\n    name == 'InternalAdmin_CompanyOnboarding_Click_OnboardCompany', '🏢 SUNID Onboarded',\n    name == 'Auth_Login_Success', '🔐 Login',\n    'Other'\n)\n| summarize Count = count() by Day = bin(timestamp, 1d), Activity\n| order by Day asc",
              "size": 0,
              "aggregation": 5,
              "title": "All Admin Activities Timeline",
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "areachart"
            },
            "name": "admin-query-combined"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "Admin"
      },
      "name": "group-admin"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "🔍 Observability Dashboard",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Observability Dashboard\n\nComprehensive monitoring dashboard for critical system operations including payment acknowledgments, application availability, profile monitoring, ADF batch flows, and OBS rate files.\n\n**Alert Thresholds:**\n- 🔴 Payment ACK timeout: 5 minutes\n- 🔴 Application availability issues\n- 🔴 Profile connectivity issues\n- 🔴 ADF batch flow failures"
            },
            "name": "obs-header"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "obs-timerange-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "ObsTimeRange",
                  "type": 4,
                  "isRequired": true,
                  "value": {
                    "durationMs": 3600000
                  },
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 1800000
                      },
                      {
                        "durationMs": 3600000
                      },
                      {
                        "durationMs": 14400000
                      },
                      {
                        "durationMs": 43200000
                      },
                      {
                        "durationMs": 86400000
                      },
                      {
                        "durationMs": 604800000
                      }
                    ],
                    "allowCustom": true
                  },
                  "label": "Time Range"
                },
                {
                  "id": "obs-company-param",
                  "version": "KqlParameterItem/1.0",
                  "name": "ObsCompanyFilter",
                  "type": 2,
                  "description": "Filter by company",
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "customEvents\n| where timestamp >= ago(7d)\n| where isnotempty(customDimensions.companyId)\n| summarize by CompanyId = tostring(customDimensions.companyId), CompanyName = tostring(customDimensions.companyName)\n| order by CompanyName asc\n| project value = CompanyId, label = strcat(CompanyName, ' (', CompanyId, ')'), selected = false\n| union (datatable(value:string, label:string, selected:boolean)[\n'*', 'All Companies', true\n])",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "defaultValue": "value::1",
                  "queryType": 0,
                  "resourceType": "microsoft.insights/components"
                }
              ],
              "style": "pills",
              "queryType": 0,
              "resourceType": "microsoft.insights/components"
            },
            "name": "obs-parameters"
          },
          {
            "type": 1,
            "content": {
              "json": "---\n## 💳 Payment Monitoring\n\nMonitoring payment initiation and acknowledgment from JGPS. **Alert triggered when no ACK received within 5 minutes.**"
            },
            "name": "obs-payment-header"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let timeoutThreshold = 5m;\nlet paymentInitiations = customEvents\n| where timestamp >= {ObsTimeRange:start} and timestamp <= {ObsTimeRange:end}\n| where name startswith \"Payments_\" and name contains \"Submit\"\n| extend CompanyId = tostring(customDimensions.companyId),\n         TransactionId = tostring(customDimensions.transactionId),\n         CompanyName = tostring(customDimensions.companyName),\n         PaymentType = tostring(customDimensions.paymentType),\n         Amount = todouble(customDimensions.amount),\n         Currency = tostring(customDimensions.currency)\n| where \"*\" in ({ObsCompanyFilter}) or CompanyId in ({ObsCompanyFilter})\n| project InitiationTime = timestamp, CompanyId, TransactionId, CompanyName, PaymentType, Amount, Currency;\nlet paymentAcks = customEvents\n| where timestamp >= {ObsTimeRange:start} and timestamp <= {ObsTimeRange:end}\n| where name contains \"ACK\" or name contains \"Acknowledgment\" or name contains \"Response\"\n| extend CompanyId = tostring(customDimensions.companyId),\n         TransactionId = tostring(customDimensions.transactionId)\n| project AckTime = timestamp, CompanyId, TransactionId;\npaymentInitiations\n| join kind=leftouter paymentAcks on CompanyId, TransactionId\n| extend Age = coalesce(AckTime, now()) - InitiationTime\n| extend Status = case(\n    isnotempty(AckTime), \"✅ ACK Received\",\n    Age >= timeoutThreshold, \"🔴 TIMEOUT\",\n    \"⏳ Pending\"\n)\n| where Status == \"🔴 TIMEOUT\"\n| summarize TimeoutCount = count(), TotalAmount = sum(Amount)\n| extend Title = case(\n    Column == 'TimeoutCount', '🔴 Payment Timeouts',\n    Column == 'TotalAmount', '💰 Timeout Amount',\n    Column\n)\n| evaluate narrow()\n| project Title, Value",
              "size": 3,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Title",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true
              }
            },
            "name": "obs-payment-summary"
          },
          {
            "type": 1,
            "content": {
              "json": "---\n## 🌐 Application Availability\n\nMonitoring application health checks and availability tests for internal web apps and CMS custom URLs."
            },
            "name": "obs-availability-header"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "availabilityResults\n| where timestamp >= {ObsTimeRange:start} and timestamp <= {ObsTimeRange:end}\n| summarize\n    TotalTests = count(),\n    SuccessfulTests = countif(success == true),\n    FailedTests = countif(success == false),\n    AvailabilityRate = round(todouble(countif(success == true)) / todouble(count()) * 100, 2)\n| evaluate narrow()\n| extend Title = case(\n    Column == 'TotalTests', '📊 Total Tests',\n    Column == 'SuccessfulTests', '✅ Successful',\n    Column == 'FailedTests', '❌ Failed',\n    Column == 'AvailabilityRate', '📈 Availability %',\n    Column\n)\n| project Title, Value",
              "size": 3,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Title",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true,
                      "maximumFractionDigits": 2
                    }
                  }
                },
                "showBorder": true
              }
            },
            "name": "obs-availability-summary"
          },
          {
            "type": 1,
            "content": {
              "json": "---\n## 👤 Profile & ADF Monitoring\n\nReal-time monitoring for profile-related issues and ADF batch flow connectivity."
            },
            "name": "obs-profile-header"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union customEvents, exceptions, traces\n| where timestamp >= {ObsTimeRange:start} and timestamp <= {ObsTimeRange:end}\n| where name contains 'Profile' or message contains 'profile' or message contains 'Profile'\n    or customDimensions contains 'profile' or customDimensions contains 'Profile'\n    or message contains 'ADF' or message contains 'batch'\n| extend Severity = case(\n    itemType == 'exception', '🔴 Error',\n    severityLevel >= 3, '🔴 Error',\n    severityLevel == 2, '⚠️ Warning',\n    '✅ Info'\n)\n| summarize\n    TotalIssues = count(),\n    Errors = countif(Severity == '🔴 Error'),\n    Warnings = countif(Severity == '⚠️ Warning')\n| evaluate narrow()\n| extend Title = case(\n    Column == 'TotalIssues', '📊 Total Issues',\n    Column == 'Errors', '🔴 Errors',\n    Column == 'Warnings', '⚠️ Warnings',\n    Column\n)\n| project Title, Value",
              "size": 3,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Title",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true
                    }
                  }
                },
                "showBorder": true
              }
            },
            "name": "obs-profile-summary"
          },
          {
            "type": 1,
            "content": {
              "json": "---\n## 📄 OBS Rate Files\n\nMonitoring OBS rate file processing and related operations."
            },
            "name": "obs-obs-header"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union customEvents, traces\n| where timestamp >= {ObsTimeRange:start} and timestamp <= {ObsTimeRange:end}\n| where name contains 'OBS' or name contains 'Rate' or name contains 'File'\n    or message contains 'OBS' or message contains 'rate file' or message contains 'Rate File'\n| extend Status = case(\n    message contains 'success' or message contains 'Success' or message contains 'completed', '✅ Success',\n    message contains 'error' or message contains 'Error' or message contains 'failed', '❌ Failed',\n    message contains 'processing' or message contains 'Processing', '⏳ Processing',\n    '📝 Other'\n)\n| summarize\n    TotalEvents = count(),\n    Successful = countif(Status == '✅ Success'),\n    Failed = countif(Status == '❌ Failed')\n| evaluate narrow()\n| extend Title = case(\n    Column == 'TotalEvents', '📊 Total Events',\n    Column == 'Successful', '✅ Successful',\n    Column == 'Failed', '❌ Failed',\n    Column\n)\n| project Title, Value",
              "size": 3,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Title",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true
                    }
                  }
                },
                "showBorder": true
              }
            },
            "name": "obs-obs-summary"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "Observability"
      },
      "name": "group-observability"
    }
  ],
  "fallbackResourceIds": [
    "${subscription_id}/resourceGroups/${resource_group_name}/providers/microsoft.insights/components/${application_insights_name}"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
