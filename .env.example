# Environment Configuration
VITE_ENVIRONMENT=development

# Azure Application Insights Configuration
# Replace with your actual Application Insights connection string from Azure Portal
VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-instrumentation-key-here;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/;LiveEndpoint=https://your-region.livediagnostics.monitor.azure.com/;ApplicationId=your-application-id-here

# Application Version
VITE_APP_VERSION=1.0.0